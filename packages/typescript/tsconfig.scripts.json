{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "scripts",
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "inlineSources": false
  },
  "include": [
    "scripts/**/*.mjs",
    "scripts/**/*.ts"
  ]
}
