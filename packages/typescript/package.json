{
  "name": "personalitygen",
  "version": "0.3.0",
  "description": "Generate simulated character personalities for games, stories, and simulations.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "typecheck:compat": "tsc6 -p tests/compat/tsconfig.json",
    "lint": "biome check src tests examples scripts",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/*.test.js",
    "examples": "npm run build && tsc -p tsconfig.examples.json && node scripts/run-examples.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:release-tag": "node scripts/verify-release-tag.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run examples && npm run typecheck:compat && npm run verify:package",
    "prepack": "npm run build"
  },
  "keywords": [
    "personality",
    "big-five",
    "ocean",
    "abbf",
    "character-generation",
    "procedural-generation",
    "game-development",
    "games",
    "simulation",
    "typescript",
    "javascript"
  ],
  "author": "B.T. Franklin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btfranklin/personalitygen.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/btfranklin/personalitygen/issues"
  },
  "homepage": "https://github.com/btfranklin/personalitygen#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": ">=2.5.5",
    "@types/node": ">=26.1.1",
    "@typescript/typescript6": ">=6.0.2",
    "typescript": ">=7.0.2"
  }
}
